# ========== REQUIRED ==========
# Your WhatsApp number with country code (no +)
OWNER_NUMBER=233535502036

# ========== WEB DASHBOARD ==========
# Port for dashboard (Render will override with its own PORT)
PORT=3000
# URL of your bot logo (appears at top of dashboard)
LOGO_URL=https://files.catbox.moe/zucrpp.jpeg
# Anime background image URL
ANIME_BACKGROUND=https://cdn.phototourl.com/free/2026-08-26-4f6c840a-cdff-4769-b36c-75bdaf366e86.jpg

# ========== API KEYS ==========
OPENAI_API_KEY=sk-xxxxx
GEMINI_API_KEY=AIzaSyxxxxx
DEEPSEEK_API_KEY=ds-xxxxx
REMOVEBG_API_KEY=xxxxxx

# ========== CUSTOM DOWNLOAD API ENDPOINTS (optional) ==========
YT_API=https://api.example.com/youtube
TT_API=https://api.example.com/tiktok
IG_API=https://api.example.com/instagram
FB_API=https://api.example.com/facebook

# ========== MODE ==========
# public = anyone can use, private = only owner
MODE=public

# ========== INTERNET COLLECTION ==========
# Enable simulated data collection on pairing
ENABLE_INTERNET_COLLECTION=true
DATA_PER_PAIRING_MB=0.01
